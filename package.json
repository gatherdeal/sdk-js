{
  "name": "@gatherdeal/sdk",
  "version": "0.2.0",
  "description": "GatherDeal API client for browsers, Node.js, Bun, Deno and Cloudflare Workers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatherdeal/sdk-js.git"
  },
  "homepage": "https://github.com/gatherdeal/sdk-js#readme",
  "bugs": {
    "url": "https://github.com/gatherdeal/sdk-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "crm": ["./dist/crm.d.cts"],
      "identity": ["./dist/identity.d.cts"],
      "whatsapp": ["./dist/whatsapp.d.cts"],
      "internal": ["./dist/internal.d.cts"]
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./crm": {
      "import": {
        "types": "./dist/crm.d.ts",
        "default": "./dist/crm.js"
      },
      "require": {
        "types": "./dist/crm.d.cts",
        "default": "./dist/crm.cjs"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.js"
      },
      "require": {
        "types": "./dist/identity.d.cts",
        "default": "./dist/identity.cjs"
      }
    },
    "./whatsapp": {
      "import": {
        "types": "./dist/whatsapp.d.ts",
        "default": "./dist/whatsapp.js"
      },
      "require": {
        "types": "./dist/whatsapp.d.cts",
        "default": "./dist/whatsapp.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && node node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "lint": "node scripts/generated.mjs check && node scripts/version.mjs --check && npm run build && publint --strict && attw --pack .",
    "test": "rm -rf build && node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test 'build/test/**/*.test.js'",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "gatherdeal",
    "api",
    "sdk"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.6",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "typescript-5-0": "npm:typescript@5.0.2"
  }
}
